# Copy to .env and fill in. Never commit real values.
SUPABASE_DB_URL=postgresql://postgres:<password>@<host>:5432/postgres
GEMINI_API_KEY=your-gemini-api-key
# Optional. Defaults: gemini-3.1-flash-lite, with gemini-3.5-flash-lite as the fallback.
# Set GEMINI_FALLBACK_MODEL=none to pin a run to one model (evals).
# GEMINI_MODEL=gemini-3.1-flash-lite
# GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
# Use the host of the region your Langfuse project lives in (EU/US/JP: https://jp.cloud.langfuse.com).
LANGFUSE_HOST=https://cloud.langfuse.com
# dev | eval | prod. Tags every trace. Set LANGFUSE_ENABLED=false to switch tracing off.
APP_ENV=dev

# ---- API (step 12) ----
# Comma-separated origins CORS allows (the frontend). Nothing is allowed when empty.
FRONTEND_ORIGINS=http://localhost:5173
# Set true only behind a proxy you control: the client IP is then the last X-Forwarded-For entry.
TRUSTED_PROXY=false
# Required when APP_ENV=prod (the API refuses to start without them):
# IP_HASH_SECRET=a-long-random-string
# SAMPLE_RUN_ID=the-id-of-a-completed-run-shown-on-the-unavailable-screen
# Local development without a database: API_STORE=memory
