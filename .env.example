# Copy to backend/.env (git-ignored) and fill in. Never commit real values.
# In production the secrets come from Secret Manager and the rest are plain Cloud Run
# environment variables: see docs/DEPLOY.md. Every setting the code reads is listed here.

# ---- Database ----
# Supabase Postgres. On Cloud Run use the SESSION POOLER string (the direct host is IPv6 only).
SUPABASE_DB_URL=postgresql://postgres:<password>@<host>:5432/postgres
# Local development without a database: set API_STORE=memory (seed-file prices, in-process runs).
# API_STORE=memory

# ---- Gemini ----
GEMINI_API_KEY=your-gemini-api-key
# Evals only. A separate key, never the demo key (the eval runner refuses to start otherwise).
# GEMINI_EVAL_API_KEY=your-eval-key
# Optional. Defaults: gemini-3.1-flash-lite, with gemini-3.5-flash-lite as the fallback.
# Set GEMINI_FALLBACK_MODEL=none to pin a run to one model (evals).
# GEMINI_MODEL=gemini-3.1-flash-lite
# GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
# Optional. Per-request timeout in seconds for one agent (ingredient, price or planner), clamped
# to 8..25. Defaults: ingredient 12, price 25, planner 12.
# GEMINI_TIMEOUT_INGREDIENT_S=12
# GEMINI_TIMEOUT_PRICE_S=25
# GEMINI_TIMEOUT_PLANNER_S=12

# ---- Tracing (Langfuse) ----
# Without both keys tracing is off. LANGFUSE_BASE_URL is accepted as an alias of LANGFUSE_HOST.
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
# Use the host of the region your Langfuse project lives in (EU/US/JP: https://jp.cloud.langfuse.com).
LANGFUSE_HOST=https://cloud.langfuse.com
# Set false to switch tracing off even with the keys.
# LANGFUSE_ENABLED=true

# ---- Environment ----
# dev | eval | prod. Tags every trace; prod makes the API refuse to start without its secrets.
APP_ENV=dev

# ---- API ----
# Comma-separated origins CORS allows (the frontend). Nothing is allowed when empty.
FRONTEND_ORIGINS=http://localhost:5173
# Set true only behind a proxy you control: the client IP is then the last X-Forwarded-For entry.
TRUSTED_PROXY=false
# Required when APP_ENV=prod (the API refuses to start without them):
# IP_HASH_SECRET=a-long-random-string
# SAMPLE_RUN_ID=the-id-of-a-completed-run-shown-on-the-unavailable-screen
# The built frontend to serve from the same origin. Default: frontend/dist when it has been built.
# FRONTEND_DIST=/app/frontend/dist

# ---- Daily job (POST /internal/daily, called by Cloud Scheduler) ----
# Both are needed for the endpoint to work; without them it answers 503 (it fails closed).
# The service URL the scheduler's identity token is addressed to:
# DAILY_JOB_AUDIENCE=https://<service>-<project number>.<region>.run.app
# The only service account allowed to call it:
# DAILY_JOB_SA_EMAIL=<name>@<project>.iam.gserviceaccount.com
